NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PATH=./data/tensorhub.db
TRUST_PROXY=1
APP_ORIGIN=https://events.example.com
# Set these only in the deployment secret manager to provision the Technical Team account.
TECHNICAL_TEAM_EMAIL=team@example.com
TECHNICAL_TEAM_PASSWORD=replace-with-a-unique-12-character-password
# Optional administrator account for protected admin APIs and reporting.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-character-password
